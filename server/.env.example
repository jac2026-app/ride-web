PORT=3000

# Set this to your site's domain once it's live, e.g. https://austinluxurysuv.com
# Leave as * only for local testing.
ALLOWED_ORIGIN=*

# A private key only you know. Send it as an "x-api-key" header to view or
# update ride requests at GET/PATCH /api/rides. Pick any long random string.
ADMIN_KEY=change-this-to-a-long-random-secret
