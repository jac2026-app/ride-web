PORT=3000

# Set this to your site's domain once it's live, e.g. https://austinluxurysuv.com
# Leave as * only for local testing.
ALLOWED_ORIGIN=*

# A private key only you know. Send it as an "x-api-key" header to view or
# update ride requests at GET/PATCH /api/rides. Pick any long random string.
ADMIN_KEY=change-this-to-a-long-random-secret

# Email me every new ride request (optional — leave blank to turn off).
# GMAIL_APP_PASSWORD is a 16-character App Password from
# https://myaccount.google.com/apppasswords — NOT your real Gmail password.
GMAIL_USER=austinluxurysuv.booking@gmail.com
GMAIL_APP_PASSWORD=
# Where notifications go (defaults to GMAIL_USER)
NOTIFY_EMAIL=

# Local testing only: also serve the website at http://localhost:3000/
# Leave this out (or false) on the live server.
SERVE_FRONTEND=true
